# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-4-hydrogen
PROMPTS_DIR=prompts

# Threads API (Meta)
THREADS_USER_ID=your_threads_user_id_here
THREADS_ACCESS_TOKEN=your_threads_long_lived_access_token_here
THREADS_TOPIC_TAG=アイルランド生活

# Post settings
POST_LANGUAGE=ja
NEWS_COUNT=5

# Optional security for /publish endpoint (recommended for Cloud Run)
API_SECRET=
DRY_RUN=false
